<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ChrisUsher.Core.Shared</RootNamespace>
    <AssemblyName>ChrisUsher.Core.Shared</AssemblyName>
    <Version>0.1.1</Version>
    <PackageId>ChrisUsher.Core.Shared</PackageId>
    <Authors>Chris Usher</Authors>
    <Description>Shared .NET utilities for JSON serialization, date and time handling, currency formatting, and common data operations.</Description>
    <Copyright>Copyright (c) Chris Usher 2026</Copyright>
    <PackageProjectUrl>https://github.com/chrisusher/Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chrisusher/Core.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>shared utilities json datetime currency dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release. Full release notes: https://github.com/chrisusher/Core/blob/main/Shared/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
    <None Include=".\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
